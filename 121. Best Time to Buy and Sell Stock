class Solution:
    def maxProfit(self, prices: List[int]) -> int:

        max_profit = 0
        current_min = 0

        for i in range(1, len(prices)):
            if prices[i] < prices[current_min]:
                current_min = i
                continue
            
            max_profit = max(prices[i] - prices[current_min], max_profit)

        return max_profit
