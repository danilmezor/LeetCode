import re

class Solution:
    def isPalindrome(self, s: str) -> bool:

        # s = s.lower().replace(' ', '').replace(',', '').replace(':', '').replace('.', '').replace('@', '').replace('#', '')
        # s = ''.join(char.lower() for char in s if char.isalnum())
        s = re.sub(r'[^a-zA-Z0-9]', '', s.lower())

        for i in range(len(s) // 2):
            if s[i] != s[-(i+1)]:
                return False

        return True 
        
