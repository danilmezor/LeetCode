from collections import Counter

class Solution:
    def closeStrings(self, word1: str, word2: str) -> bool:

        dict_1 = dict(Counter(word1))
        dict_2 = dict(Counter(word2))

        if (sorted(list(dict_1.values())) == sorted(list(dict_2.values()))) and (sorted(list(dict_1.keys())) == sorted(list(dict_2.keys()))):
            return True
        else:
            return False
