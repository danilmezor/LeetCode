# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def deleteMiddle(self, head: Optional[ListNode]) -> Optional[ListNode]:

        pointer = head
        counter = 0
        while pointer:
            pointer = pointer.next
            counter += 1
        if counter == 1:
            return None
        elif counter == 2:
            head.next = None
            return head

        slow = head
        fast = head
        before_slow = None
        while fast and fast.next:
            before_slow = slow
            slow = slow.next
            fast = fast.next.next
            
        before_slow.next = slow.next
        return head
