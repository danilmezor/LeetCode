class Solution:
    def longestSubarray(self, nums: List[int]) -> int:

        zeros_flipped = 0
        left = 0
        answer = 0
        
        for right in range(len(nums)):
            if nums[right] == 0:
                zeros_flipped += 1
                
            while zeros_flipped > 1:
                left += 1
                if nums[left-1] == 0:
                    zeros_flipped -= 1
                
            answer = max(answer, right - left)
            
        return answer
