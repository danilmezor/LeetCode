class Solution:
    def equalPairs(self, grid: List[List[int]]) -> int:
        
        counter = 0

        # create a list of lists of columns
        columns = []
        for i in range(len(grid[0])):
            column = []
            for j in range(len(grid[0])):
                column.append(grid[j][i])
            columns.append(column)    

        for i in range(len(grid[0])):
            for j in range(len(grid[0])):
                if columns[i] == grid[j]:
                    counter += 1

        return counter
