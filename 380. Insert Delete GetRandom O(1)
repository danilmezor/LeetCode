    def __init__(self):
        self.nums = []
        self.val_to_index = {}
        
    def insert(self, val: int) -> bool:
        if val in self.val_to_index.keys():
            return False
        elif val not in self.val_to_index.keys():
            self.nums.append(val)
            self.val_to_index[val] = len(self.nums)-1
            return True

    def remove(self, val: int) -> bool:
        if val not in self.val_to_index.keys():
            return False   

        if val in self.val_to_index.keys():
            index = self.val_to_index.get(val)
            last_element = self.nums[-1]
            
            self.nums[index], self.nums[-1] = self.nums[-1], self.nums[index]
            
            if index != len(self.nums) - 1:  # Only if we're not removing the last element
                self.val_to_index[last_element] = index
                
            self.val_to_index.pop(val)
            self.nums.pop()
            return True
     
    def getRandom(self) -> int:
        return self.nums[random.randint(0, len(self.nums)-1)]


