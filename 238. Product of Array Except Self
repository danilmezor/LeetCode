class Solution:
    def productExceptSelf(self, nums: List[int]) -> List[int]:
        product = 1
        answer = []
        zero_counter = 0
        for number in nums:
            if number != 0:
                product *= number
            else:
                zero_counter += 1

        if zero_counter > 1:
            return [0] * len(nums)

        for number in nums:
            if number != 0 and zero_counter < 1:
                answer.append(int(product / number))
            elif number != 0 and zero_counter >= 1:
                answer.append(0)
            else:
                answer.append(product)

        return answer
