class Solution:
    def maxOperations(self, nums: List[int], k: int) -> int:
        nums.sort()
        
        operations = 0
        left_pointer = 0
        right_pointer = len(nums)-1

        while left_pointer < right_pointer:
            if nums[left_pointer] + nums[right_pointer] == k:
                operations += 1
                left_pointer += 1
                right_pointer -= 1
            elif nums[left_pointer] + nums[right_pointer] < k:
                left_pointer += 1
            elif nums[left_pointer] + nums[right_pointer] > k:
                right_pointer -= 1
        
        return operations
        
