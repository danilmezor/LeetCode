import math

class Solution:

    def range_checker(self, number):
        if number <= math.pow(2, 31) * -1:
            return 0
        elif number >= math.pow(2, 31) -1:
            return 0
        else:
            return number

    def is_negative_checker(self, string):
        if string[0] == '-':
            return string, True
        else:
            return string, False

    def reverse(self, x: int) -> int:

        reversed_string = ''
        num_to_string = str(x)

        string_checked, neg_answer = self.is_negative_checker(num_to_string)

        if not neg_answer:
            string_checked = num_to_string[::-1]
            final_int = int(string_checked)
        if neg_answer:
            string_checked = num_to_string[1:]
            string_checked = string_checked[::-1]
            final_int = int(string_checked) * -1

        final_int = self.range_checker(final_int)

        return final_int
        
