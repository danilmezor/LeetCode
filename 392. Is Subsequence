class Solution:
    def isSubsequence(self, s: str, t: str) -> bool:
        ptr_s = 0

        if len(s) == 0:
            return True

        for ptr_t in range(len(t)):
            if s[ptr_s] == t[ptr_t]:
                ptr_s += 1
                if ptr_s == len(s):
                    return True
        
        return ptr_s == len(s)
